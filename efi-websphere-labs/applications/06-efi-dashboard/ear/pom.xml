<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>fr.efiacademy.lab</groupId>
    <artifactId>efi-dashboard-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>efi-dashboard-ear</artifactId>
  <packaging>ear</packaging>
  <name>EFI Server Dashboard (module EAR)</name>

  <dependencies>
    <dependency>
      <groupId>fr.efiacademy.lab</groupId>
      <artifactId>efi-dashboard-web</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
  </dependencies>

  <build>
    <finalName>efi-dashboard</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-ear-plugin</artifactId>
        <configuration>
          <version>6</version>
          <defaultLibBundleDir>lib</defaultLibBundleDir>
          <!-- Le descripteur META-INF/application.xml est fourni dans src/main/application -->
          <generateApplicationXml>false</generateApplicationXml>
          <modules>
            <webModule>
              <groupId>fr.efiacademy.lab</groupId>
              <artifactId>efi-dashboard-web</artifactId>
              <bundleFileName>efi-dashboard.war</bundleFileName>
              <contextRoot>/efi-dashboard</contextRoot>
            </webModule>
          </modules>
          <archive>
            <manifestEntries>
              <Implementation-Title>EFI Server Dashboard</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
              <Implementation-Vendor>EFI Academy</Implementation-Vendor>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
